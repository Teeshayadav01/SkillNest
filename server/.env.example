# Server
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillnest?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin seed script (used only when running: npm run seed:admin)
ADMIN_NAME=SkillNest Admin
ADMIN_EMAIL=admin@skillnest.com
ADMIN_PASSWORD=ChangeThisPassword123
